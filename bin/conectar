#!/usr/bin/env bash
#
# conectar — liga na porta que um colega abriu.
#
# Este é o lado "cliente". Só funciona se do outro lado alguém já tiver rodado
# `escutar` na mesma porta: uma porta sem ninguém escutando recusa a conexão na
# hora, e é isso que significa "connection refused".

set -uo pipefail

alvo=${1:-}
porta=${2:-}

if [[ -z "$alvo" || -z "$porta" ]]; then
    echo "uso: conectar IP PORTA"
    echo
    echo "exemplo: conectar 10.99.0.7 4444"
    echo
    echo "Não sabe o IP do colega? Rode:  descobrir"
    exit 1
fi

if ! [[ "$porta" =~ ^[0-9]+$ ]] || (( porta < 1 || porta > 65535 )); then
    echo "porta inválida: $porta (use um número de 1 a 65535)" >&2
    exit 1
fi

echo "conectando em $alvo na porta $porta ..."
echo "(se conectar, o que você digitar aparece na tela do colega; Ctrl+C encerra)"
echo "---"

# Aqui NÃO testamos a porta antes de conectar, por mais tentador que seja para
# dar uma mensagem de erro bonita. O `escutar` do outro lado aceita UMA conexão
# e encerra — um teste prévio seria essa conexão, e a de verdade chegaria depois
# do servidor já ter saído. O sintoma é cruel: o teste passa e a conexão falha.
#
# Então conectamos de uma vez e explicamos depois, se der errado.
#
# Também não usamos -w: no nc do OpenBSD esse valor não é só timeout para
# conectar, é também timeout de ociosidade. Numa conversa de aula, alguns
# segundos sem ninguém digitar são normais, e a conexão cairia sozinha no meio
# — sem mensagem nenhuma, o pior tipo de falha. Não precisamos dele: nesta rede
# um IP inexistente já falha em ~3s com "No route to host".
#
# -v faz o nc contar o que aconteceu.
nc -v "$alvo" "$porta"
status=$?

# O nc devolve 1 quando não conseguiu conectar, e 0 quando houve conversa —
# inclusive se o aluno encerrou com Ctrl+C. Por isso olhamos o status exato: um
# "não consegui conectar" depois de uma conversa que funcionou seria mentira.
if (( status == 1 )); then
    echo >&2
    echo "não consegui conectar em $alvo:$porta." >&2
    echo >&2
    echo "As causas mais comuns, em ordem:" >&2
    echo "  1. ninguém rodou 'escutar $porta' do outro lado ainda" >&2
    echo "  2. o colega escutou, mas alguém já conectou antes de você —" >&2
    echo "     o escutar atende uma conexão por vez; peça para ele rodar de novo" >&2
    echo "  3. a porta combinada não é a mesma dos dois lados" >&2
    echo "  4. o IP está errado — rode 'descobrir' para conferir" >&2
    exit 1
fi

exit $status
